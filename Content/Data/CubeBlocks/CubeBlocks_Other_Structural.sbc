<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <CubeBlocks>
        <Definition>
            <Id>
                <TypeId>Conveyor</TypeId>
                <SubtypeId>GVK_HeavyTurretMount_3x3x1</SubtypeId>
            </Id>
            <DisplayName>Heavy Turret Mount Plate</DisplayName>
            <Icon>Textures\GUI\Icons\Cubes\GVK_HeavyTurretMount_3x3x1.dds</Icon>
            <Description>Heavy-armored 3x3x1 structural turret mounting foundation with top and bottom large conveyor ports.</Description>
            <CubeSize>Large</CubeSize>
            <BlockTopology>TriangleMesh</BlockTopology>
            <Size x="3" y="1" z="3" />
            <ModelOffset x="0" y="0" z="0" />
            <Model>Models\Cubes\large\GVK_HeavyTurretMount_3x3x1.mwm</Model>
            <Components>
                <Component Subtype="SteelPlate" Count="500" />
                <Component Subtype="Construction" Count="300" />
                <Component Subtype="MetalGrid" Count="450" />
                <Component Subtype="SmallTube" Count="160" />
                <Component Subtype="LargeTube" Count="90" />
                <Component Subtype="Motor" Count="60" />
                <Component Subtype="Construction" Count="260" />
                <Component Subtype="InteriorPlate" Count="200" />
                <Component Subtype="SteelPlate" Count="550" />
            </Components>
            <CriticalComponent Subtype="Construction" Index="1" />
            <MountPoints>
                <MountPoint Side="Bottom" StartX="0" StartY="0" EndX="3" EndY="3" Default="true" />
                <MountPoint Side="Top" StartX="0" StartY="0" EndX="3" EndY="3" />
                <MountPoint Side="Front" StartX="0" StartY="0" EndX="3" EndY="1" />
                <MountPoint Side="Back" StartX="0" StartY="0" EndX="3" EndY="1" />
                <MountPoint Side="Left" StartX="0" StartY="0" EndX="3" EndY="1" />
                <MountPoint Side="Right" StartX="0" StartY="0" EndX="3" EndY="1" />
            </MountPoints>
            <BuildProgressModels>
                <Model BuildPercentUpperBound="0.33" File="Models\Cubes\large\GVK_HeavyTurretMount_3x3x1_BS1.mwm" />
                <Model BuildPercentUpperBound="0.66" File="Models\Cubes\large\GVK_HeavyTurretMount_3x3x1_BS2.mwm" />
                <Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\GVK_HeavyTurretMount_3x3x1_BS3.mwm" />
            </BuildProgressModels>
            <BlockPairName>GVK_HeavyTurretMount_3x3x1</BlockPairName>
            <MirroringY>Z</MirroringY>
            <MirroringZ>Y</MirroringZ>
            <EdgeType>Heavy</EdgeType>
            <BuildTimeSeconds>198</BuildTimeSeconds>
            <DisassembleRatio>2.5</DisassembleRatio>
            <GeneralDamageMultiplier>0.5</GeneralDamageMultiplier>
            <PCU>10</PCU>
            <IsAirTight>true</IsAirTight>
        </Definition>
